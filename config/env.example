# Copie este arquivo para .env na raiz do projeto e preencha os valores.
# NUNCA envie o .env para o GitHub.
PORT=3000
NODE_ENV=development

# Endereço público do site (usado no link de "esqueci minha senha")
SITE_URL=http://localhost:3000

# Supabase -> Project Settings > API Keys
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (sb_publishable_...). Os nomes antigos SUPABASE_ANON_KEY também funcionam.
SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_...): SOMENTE no servidor, nunca no front-end nem no GitHub.
# Os nomes antigos SUPABASE_SERVICE_ROLE_KEY também funcionam.
SUPABASE_SECRET_KEY=
